{
  "info": {
    "_postman_id": "resume-ai-agent-mcp-server-v1",
    "name": "Resume AI Agent - MCP Server",
    "description": "Postman collection for the Resume AI Agent MCP Server (MuleSoft Streamable HTTP on port 8082).\n\n**Usage:**\n1. Run 'Initialize' first — session ID is auto-captured.\n2. Run 'Notifications Initialized' to complete handshake.\n3. Call any tool request.\n\n**Transport:** MCP Streamable HTTP (JSON-RPC 2.0) — POST http://localhost:8082/mcp",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "mcpBaseUrl", "value": "http://localhost:8082", "type": "string" },
    { "key": "mcpSessionId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "🔌 Connection",
      "item": [
        {
          "name": "1. Initialize",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sessionId = pm.response.headers.get('mcp-session-id');",
                  "if (sessionId) {",
                  "    pm.collectionVariables.set('mcpSessionId', sessionId);",
                  "    console.log('MCP Session ID captured:', sessionId);",
                  "}",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Result present', () => pm.expect(pm.response.json()).to.have.property('result'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json, text/event-stream" }
            ],
            "url": { "raw": "{{mcpBaseUrl}}/mcp", "host": ["{{mcpBaseUrl}}"], "path": ["mcp"] },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"initialize\",\n  \"params\": {\n    \"protocolVersion\": \"2024-11-05\",\n    \"capabilities\": {},\n    \"clientInfo\": { \"name\": \"postman-client\", \"version\": \"1.0.0\" }\n  }\n}"
            },
            "description": "REQUIRED FIRST. Establishes an MCP session. The test script auto-captures `mcp-session-id` from the response header into `{{mcpSessionId}}`."
          }
        },
        {
          "name": "2. Notifications — Initialized",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Notification accepted', () => pm.expect(pm.response.code).to.be.oneOf([200, 202, 204]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json, text/event-stream" },
              { "key": "mcp-session-id", "value": "{{mcpSessionId}}" }
            ],
            "url": { "raw": "{{mcpBaseUrl}}/mcp", "host": ["{{mcpBaseUrl}}"], "path": ["mcp"] },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"notifications/initialized\"\n}"
            },
            "description": "One-way notification to complete the MCP handshake after Initialize. No `id` field — server returns 202 or empty 200."
          }
        },
        {
          "name": "3. List Tools",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tools array present', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.result.tools).to.be.an('array').and.not.empty;",
                  "    console.log('Tools:', body.result.tools.map(t => t.name).join(', '));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json, text/event-stream" },
              { "key": "mcp-session-id", "value": "{{mcpSessionId}}" }
            ],
            "url": { "raw": "{{mcpBaseUrl}}/mcp", "host": ["{{mcpBaseUrl}}"], "path": ["mcp"] },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"method\": \"tools/list\",\n  \"params\": {}\n}"
            },
            "description": "Returns the list of all 9 MCP tools registered with this server, with their names, descriptions, and input schemas."
          }
        }
      ]
    },
